{
  "consumer": {
    "name": "web"
  },
  "interactions": [
    {
      "description": "a profile request",
      "providerStates": [
        {
          "name": "an authenticated profile exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/profile"
      },
      "response": {
        "body": {
          "firstName": "سارا",
          "id": 1,
          "lastName": "احمدی",
          "role": "admin"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.3"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "khadamat-gostar-api"
  }
