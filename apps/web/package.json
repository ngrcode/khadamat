{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"console.error('Direct development is disabled. Run: npm run docker:up'); process.exit(1)\"",
    "build": "next build",
    "start": "next start",
    "api:generate": "orval --config orval.config.ts",
    "api:watch": "orval --config orval.config.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/hooks tests/store",
    "test:component": "vitest run tests/components",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/schema",
    "test:contract": "CONTRACT_TESTS=1 vitest run tests/contracts",
    "test:mutation": "stryker run",
    "test:query": "vitest run tests/react-query",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/e2e/app.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:load": "k6 run tests/load/smoke.js",
    "test:security": "npm audit --audit-level=high",
    "test:zap": "docker run --rm -t owasp/zap2docker-stable zap-baseline.py -t ${ZAP_TARGET:-http://host.docker.internal:3100}",
    "test:performance": "lhci autorun --config=./lighthouserc.cjs",
    "test:visual": "VISUAL_REGRESSION=1 playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "VISUAL_REGRESSION=1 playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "lint": "biome check src tests"
  },
